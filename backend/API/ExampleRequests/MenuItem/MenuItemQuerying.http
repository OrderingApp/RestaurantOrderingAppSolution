@API_HostAddress = http://localhost:5000/api/menu-items

// To get a specific menu item by its ID.

GET {{API_HostAddress}}/28a61cca-79af-416a-9871-68e5f38d6a6b
Accept: application/json

###

// To get all menu items.

GET {{API_HostAddress}}/
Accept: application/json

###

// To get menu items by category (without additional filters).

GET {{API_HostAddress}}?categoryId=d2634aae-bfe5-4139-92d2-f0d96d3b08ef
Accept: application/json

###

// Get Menu Items by Category with Ingredients Filtering

GET {{API_HostAddress}}/?categoryId=d2634aae-bfe5-4139-92d2-f0d96d3b08ef&ingredientIds=3f94d539-6882-40f5-a079-fa8d7091bac3&ingredientIds=a4458f4c-55d7-4bb9-9fe6-6e7b88bc96ea
Accept: application/json

###

// Get Menu Items by Category with Tag Filtering

GET {{API_HostAddress}}/?categoryId=D2634AAE-BFE5-4139-92D2-F0D96D3B08EF&tags=Vegetarian
Accept: application/json
