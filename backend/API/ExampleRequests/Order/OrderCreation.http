@API_HostAddress = http://localhost:5000/api

// To create one dineIn order with 2 order items. 
// One order item with 2 extra ingredients and one without extra ingredients.

POST {{API_HostAddress}}/orders/dinein
Content-Type: application/json
Accept: application/json

{
  "dateTime": "2026-02-07T12:00:00Z",
  "tableId": "9165C97C-5477-4EED-A566-F6FEC0E84694",
  "orderItems": [
    {
      "menuItemId": "3805A7EB-F095-4180-80E6-96289B539D6B",
      "specialInstructions": "No onions, extra cheese",
      "extraIngredients": [
        {
          "ingredientId": "A4458F4C-55D7-4BB9-9FE6-6E7B88BC96EA",
          "quantity": 2
        },
        {
          "ingredientId": "8C7FC3D2-8BD6-4634-AE36-4207D439C2A4",
          "quantity": 1
        }
      ],
      "removedIngredientIds": []
    },
    {
      "menuItemId": "1A069762-854A-4EE4-B455-722C843FDE5B",
      "specialInstructions": null,
      "extraIngredients": [],
      "removedIngredientIds": []
    }
  ]
}

