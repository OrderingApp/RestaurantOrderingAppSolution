// To create one takeaway order with 2 order items. 
// One order item with 2 extra ingredients and one without extra ingredients.

POST {{API_HostAddress}}/Order/takeaway
Content-Type: application/json
Accept: application/json

{
  "orderDateTime": "2026-02-07T12:30:00Z",
  "phoneNumber": "123456789",
  "additionalInstructions": "Please call on arrival.",
  "orderCompletionType": "Immediate",
  "preferedPaymentMethod": "Cash",
  "expectedOrderCompletion": null,
