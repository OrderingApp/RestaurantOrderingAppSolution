@API_HostAddress = http://localhost:5000/api

// To create one dineIn order with 2 order items. 
// One order item with 2 extra ingredients and one without extra ingredients.

POST {{API_HostAddress}}/orders/dinein
Content-Type: application/json
Accept: application/json

{
  "discount": 10,
  "tableId": "0E85B353-9DA3-40EA-9AEA-37DC701C56AA",
  "orderItems": [
    {
      "menuItemId": "0026375D-9736-4B94-ABA5-3E7644643DFF",
      "discount": 30,
      "specialInstructions": "No onions, extra cheese",
      "extraIngredients": [
        {
          "ingredientId": "012BD3A0-F0A6-4A8D-9AE7-703EEE731302",
          "quantity": 2
        },
        {
          "ingredientId": "2201F320-8642-4275-BB32-324D592EB355",
          "quantity": 1
        }
      ],
      "removedIngredientIds": []
    },
    {
      "menuItemId": "0A762473-96D2-4409-A8CA-631C8AAA1236",
      "specialInstructions": null,
      "extraIngredients": [],
      "removedIngredientIds": []
    }
  ]
}

